APP_ENV=dev
APP_NAME=投标分析 Agent 后端
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_ECHO=false
# LangGraph checkpoint 复用 DATABASE_URL 指向的 PostgreSQL，无需单独配置。
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=3

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tender-files
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

CORS_ORIGINS=["*"]
MAX_UPLOAD_SIZE_BYTES=524288000

# OpenAI 兼容大模型回退配置。数据库没有启用的默认提供商时使用这里的配置。
# BASE_URL 留空时使用 OpenAI 官方地址。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=120

# PDF 有效文字少于该值时启用 PaddleOCR。
PDF_TEXT_MIN_CHARS=300
OCR_LANGUAGE=ch
OCR_RENDER_SCALE=2.0
