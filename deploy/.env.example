# 复制为仓库根目录 .env 后按需修改：cp deploy/.env.example .env

# 基础设施口令（务必修改默认值）
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tender
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tender-files

# 大模型回退配置（数据库里配置了默认提供商时可以不填）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=120

# CORS（桌面端直连通常保持 * 即可）
CORS_ORIGINS=*

# 可选：Web 前端构建时指定的后端地址。留空表示同源反代（nginx 自动把 /api 转到 backend）
VITE_BACKEND_URL=

# 扫描件 OCR：设为 true 时镜像会安装 PaddleOCR（体积 +2GB）
WITH_OCR=false

# 其他可选配置
LOG_LEVEL=INFO
PDF_TEXT_MIN_CHARS=300
OCR_LANGUAGE=ch
OCR_RENDER_SCALE=2.0
