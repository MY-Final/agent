# 复制为 deploy/infra.env 后修改，真实口令不要提交到仓库：
#   cp deploy/infra.env.example deploy/infra.env
# 启动：
#   docker compose --env-file deploy/infra.env -f deploy/infra.docker-compose.yml up -d

# MinIO（控制台 http://<服务器IP>:29001）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please

# PostgreSQL（外网端口 15432）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=postgres

# MySQL（其他项目使用，本项目可忽略）
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_DATABASE=astrbot_diandian
MYSQL_LOCAL_ROOT_PASSWORD=change-me-please
MYSQL_LOCAL_DATABASE=local_db
